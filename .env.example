# Thaleia 環境変数 (コピーして .env に)。秘密はコミットしない。
THALEIA_PORT=8890

# ── 上流 (未設定でも起動する。 依存する評価軸は missing になり confidence が下がる) ──
# Excubitor から起動する場合は ANATOMIA_URL / DISCUTERE_URL / GENIUS_URL も解決対象。
ANATOMIA_BASE_URL=http://localhost:4200
DISCUTERE_BASE_URL=http://localhost:3110
# Discutere admin REST 用。 loopback からは admin 扱いなので通常は不要。
DISCUTERE_ADMIN_USER_ID=
GENIUS_BASE_URL=http://localhost:4230
# Augur は常駐しない。 `node <bin> review-plan` で呼ぶ entry point を指す。
AUGUR_BIN=C:/path/to/Augur/bin/augur.mjs
# Ludus は Web サービスではない。 spec/data/game-lexicon/**.toml を直接読む。
LUDUS_REPO_DIR=C:/path/to/Ludus

# ── 残置機能 (spec 起点トレース / 統合ビュー) 用 ──
PRAEFORMA_BASE_URL=http://localhost:8889
PRAEFORMA_TOKEN=

# ── ディープリンク先 (evidence → 各サービス web)。 未設定なら該当リンクを出さない ──
ANATOMIA_WEB_URL=http://localhost:4200
DISCUTERE_WEB_URL=http://localhost:3110
GENIUS_WEB_URL=http://localhost:4230
PRAEFORMA_WEB_URL=http://localhost:5173

# ── LLM (claude CLI)。 --model は必ず固定する ──
THALEIA_CLAUDE_BIN=claude
THALEIA_CLAUDE_MODEL=claude-sonnet-5
THALEIA_CLAUDE_TIMEOUT_MS=120000

# ── 重み・閾値 (省略時は設計 §5 の既定) ──
# THALEIA_WEIGHT_UX=0.25
# THALEIA_WEIGHT_COST=0.15
# THALEIA_WEIGHT_AI_FEASIBILITY=0.20
# THALEIA_WEIGHT_DOMAIN=0.15
# THALEIA_WEIGHT_DISCUSSION=0.25
# THALEIA_DEFER_THRESHOLD=0.7
# THALEIA_BANALITY_K=20
# THALEIA_LINK_CONFIDENCE_THRESHOLD=0.7
